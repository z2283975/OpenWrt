CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y

# 全局编译设置
CONFIG_ALL_KMODS=n
CONFIG_ALL=n
CONFIG_BUSYBOX_DEFAULT_SEED=y
CONFIG_BUILD_PATENTED=n
CONFIG_CCACHE=y
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_SDK=n
CONFIG_IB=n
CONFIG_DEVEL=n
CONFIG_KERNEL_KASAN=n
CONFIG_KERNEL_KCOV=n

# 文件系统 squashfs + ext4
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=800
CONFIG_PACKAGE_f2fs-tools=n
CONFIG_PACKAGE_f2fsck=n
CONFIG_PACKAGE_xfs-progs=n
CONFIG_PACKAGE_btrfs-progs=n
CONFIG_PACKAGE_ntfs3-utils=n

# 基础系统
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-offload=y

# LuCI基础 中英双语
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-i18n-zh-cn=y
CONFIG_PACKAGE_luci-i18n-en=y
CONFIG_PACKAGE_luci-i18n-ru=n
CONFIG_PACKAGE_luci-i18n-fr=n
CONFIG_PACKAGE_luci-i18n-de=n
CONFIG_PACKAGE_luci-i18n-ja=n

# Argon主题
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-bootstrap=n

# SSR-PLUS 轻量化
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray_plugin=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Redsocks2=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Server=n

# N5105 I226 2.5G网卡驱动【核心！】
CONFIG_PACKAGE_kmod-igc=y
# 其他通用有线网卡
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-rtl8125=y
CONFIG_PACKAGE_kmod-rtl8111=y

# SATA/块设备
CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-block2mtd=n

# USB（N5105自带USB，保留）
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-uhci=n
CONFIG_PACKAGE_kmod-usb-xhci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_usbids=y

# 关闭无用内核模块
CONFIG_PACKAGE_kmod-bluetooth=n
CONFIG_PACKAGE_kmod-leds-gpio=n
CONFIG_PACKAGE_kmod-gpio-button-hotplug=n
CONFIG_PACKAGE_kmod-ip6tables=n
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_pppoe-discovery=y

# 不编译多余应用
CONFIG_PACKAGE_wol=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_nlbwmon=n
CONFIG_PACKAGE_iperf3=n
CONFIG_PACKAGE_socat=n
CONFIG_PACKAGE_curl=n
CONFIG_PACKAGE_wget=n
